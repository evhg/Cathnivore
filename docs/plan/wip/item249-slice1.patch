diff --git a/src/styles/table.css b/src/styles/table.css
index d3c3bb34..02b98f25 100644
--- a/src/styles/table.css
+++ b/src/styles/table.css
@@ -4381,3 +4381,56 @@ html.no-animations .table-cath-line { animation: none; }
 }
 
 @keyframes table-cath-face { from { opacity: .2; } }
+
+/* Plan item 249: at 1400 px and up (the table's widest sizes) the board is the hero. The Market Board folds to a 2x2 block of readings
+   and shares one row with tomorrow's papers and Pell, so the cloth takes that row's height back and the hexes
+   (sized by height) grow with it. Everything else in the column keeps its own full-width row. */
+@media (min-width: 1400px) and (min-height: 760px) {
+  .game:has(.table-head.with-table-cath) {
+    display: grid;
+    grid-template-columns: auto minmax(0, 1fr);
+    grid-template-rows: auto minmax(0, 1fr) auto;
+    column-gap: var(--sp-2);
+  }
+  .game:has(.table-head.with-table-cath) :is(.game-scroll, .action-tray) > * { grid-column: 1 / -1; }
+  .game:has(.table-head.with-table-cath) .market-board { grid-column: 1; grid-row: 1; align-self: stretch; }
+  .game:has(.table-head.with-table-cath) .table-head { grid-column: 2; grid-row: 1; }
+  .game:has(.table-head.with-table-cath) .map-wrap { grid-row: 2; min-height: 0; }
+  .game:has(.table-head.with-table-cath) .table-hand { grid-row: 3; }
+
+  .game:has(.table-head.with-table-cath) .market-board {
+    grid-template-columns: 80px 74px auto;
+    grid-template-rows: 1fr 1fr;
+    grid-auto-flow: row;
+    padding: 0 2px 0 0;
+  }
+  .game:has(.table-head.with-table-cath) .board-cell {
+    padding: 2px var(--sp-2) 2px 6px;
+    gap: 0;
+  }
+  .game:has(.table-head.with-table-cath) .board-cell:nth-child(3) { box-shadow: inset 0 1px 0 var(--ink-a15); }
+  .game:has(.table-head.with-table-cath) .board-cell:nth-child(4) { box-shadow: inset 1px 0 0 var(--ink-a15), inset 0 1px 0 var(--ink-a15); }
+  .game:has(.table-head.with-table-cath) .board-head {
+    grid-template-columns: 34px auto auto;
+    grid-template-areas: "icon label num";
+    column-gap: 6px;
+  }
+  .game:has(.table-head.with-table-cath) .board-head > svg.board-object { height: 27px; justify-self: center; }
+  .game:has(.table-head.with-table-cath) .board-num { font-size: var(--fs-body); }
+  .game:has(.table-head.with-table-cath) .board-menu { grid-column: 3; grid-row: 1 / span 2; align-self: center; }
+  /* The words go to the tooltips (as on a phone): the objects and figures carry the readings, so the papers keep their width. */
+  .game:has(.table-head.with-table-cath) .market-board .board-label {
+    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0);
+  }
+}
+@media (min-width: 1400px) and (min-height: 760px) {
+  /* The memos are narrower beside the readings: the (i) sits tighter to the edge. */
+  .game:has(.table-head.with-table-cath) .plan-strip-item > button:first-child {
+    padding-right: 26px;
+    column-gap: 4px;
+  }
+  .game:has(.table-head.with-table-cath) .plan-strip-headline { letter-spacing: .02em; }
+  .game:has(.table-head.with-table-cath) .plan-strip-dateline { margin-left: 4px; }
+  .game:has(.table-head.with-table-cath) .plan-strip-item svg.plan-art { width: 24px; height: 24px; }
+  .game:has(.table-head.with-table-cath) .plan-strip-item > .tooltip-trigger { right: 3px; }
+}
