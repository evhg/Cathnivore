+/* Plan item 747: one channel language, floor and two lips: the shaded wall a dark lip, the floor the carved trough,
+   the sunlit wall a lit lip, and nothing else across the section. Item 264's cut edge, item 61's soil lip, item
+   97's spoil crumbs, damp foot and cast shadow each added a band, so a dry ditch read as five or six parallel
+   stripes and the route couldn't be traced at a glance. The floor is wider, so the trench is what the eye follows. */
+.groove-cut,
+.groove-lip,
+.lip-crumb,
+.bank-foot,
+.bank-cast {
+  display: none;
+}
+.groove { stroke-width: 24.8; }
+.groove-bed { stroke-width: 15; }
