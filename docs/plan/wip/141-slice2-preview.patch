+  animation: ghost-blink 1.1s ease-in-out infinite alternate;
+}
+
+.meter > i.ghost-loss {
+  background: color-mix(in srgb, var(--clay-deep) 45%, transparent);
+  box-shadow: inset 0 0 0 1.5px var(--clay-deep);
+  animation: ghost-blink 1.1s ease-in-out infinite alternate;
+}
+
+@keyframes ghost-blink {
+  from { opacity: 1; }
+  to { opacity: 0.45; }
+}
+
+html.no-animations .meter > i.ghost-gain,
+html.no-animations .meter > i.ghost-loss {
+  animation: none;
+}
+
+.ledger-delta {
+  font-size: var(--fs-label);
+  font-weight: 760;
+  color: var(--gain-ink);
+}
+
+.ledger-chip[data-delta^="-"] .ledger-delta {
+  color: var(--clay-deep);
+}
+
+.map .ghost-piece circle {
+  fill: color-mix(in srgb, var(--paper) 70%, transparent);
+  stroke: var(--ink);
+  stroke-width: 2.5;
+  stroke-dasharray: 5 4;
+}
+
+.map .ghost-piece path {
+  fill: none;
+  stroke: var(--ink);
+  stroke-width: 3;
+  stroke-linecap: round;
+}
+
+.map .ghost-piece[data-sign="+"] circle {
+  stroke: var(--gain-ink);
+}
+
+.map .ghost-piece[data-sign="+"] path {
+  stroke: var(--gain-ink);
+}
