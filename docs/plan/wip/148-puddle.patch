+// Plan item 148: the noir poster's puddle. A sheet of standing water at her feet, between her and the lens, that
+// mirrors the street sharply (the wet street's own planar reflection, at full strength and unblurred, where the
+// asphalt shows it soft and faint): her figure and the neon stand upside down in it. Rain rings spread across it
+// (three drops at a time, none under reduced motion). One unlit transparent draw call; the mirror never sees it.
+
+import * as THREE from "three";
+import { LAYER_NO_REFLECT } from "./reflection";
+import type { World } from "./types";
+
+export interface FrontPuddle {
+  readonly mesh: THREE.Mesh;
+  update(t: number): void;
+  dispose(): void;
+}
+
+export function buildFrontPuddle(mirror: NonNullable<World["mirror"]>, still: boolean): FrontPuddle {
+  const geo = new THREE.PlaneGeometry(1, 1, 1, 1).rotateX(-Math.PI / 2);
+  const uTime = { value: 0 };
+  const mat = new THREE.ShaderMaterial({
+    uniforms: { uRefl: mirror.uRefl, uReflMatrix: mirror.uReflMatrix, uReflOn: mirror.uReflOn, uTime, uStill: { value: still ? 1 : 0 } },
+    transparent: true,
+    depthWrite: false,
+    polygonOffset: true,
+    polygonOffsetFactor: -3,
+    polygonOffsetUnits: -3,
+    vertexShader: /* glsl */ `
+      varying vec3 vW;
+      varying vec2 vP;
+      void main() {
+        vec4 w = modelMatrix * vec4( position, 1.0 );
+        vW = w.xyz;
+        vP = position.xz * 2.0;
+        gl_Position = projectionMatrix * viewMatrix * w;
+      }`,
+    fragmentShader: /* glsl */ `
+      uniform sampler2D uRefl;
+      uniform mat4 uReflMatrix;
+      uniform float uReflOn;
+      uniform float uTime;
+      uniform float uStill;
+      varying vec3 vW;
+      varying vec2 vP;
+      float hash( float n ) { return fract( sin( n ) * 43758.5453 ); }
+      void main() {
+        // An irregular edge: a disc pushed in and out by three low lobes, feathered.
+        float r = length( vP );
+        float a = atan( vP.y, vP.x );
+        float edge = 0.8 + 0.09 * sin( 3.0 * a + 1.3 ) + 0.06 * sin( 5.0 * a + 0.4 ) + 0.04 * sin( 9.0 * a + 2.1 );
+        float mask = 1.0 - smoothstep( edge - 0.14, edge, r );
+        if ( mask < 0.003 ) discard;
+        // Rain rings: three drops, each landing somewhere new every 1.1 s, a ring running out and fading.
+        vec2 off = vec2( 0.0 );
+        float lit = 0.0;
+        if ( uStill < 0.5 ) {
+          for ( int i = 0; i < 3; i++ ) {
+            float fi = float( i );
+            float k = uTime / 1.1 + fi * 0.37;
+            float n = floor( k );
+            float age = fract( k );
+            vec2 c = vec2( hash( n * 7.1 + fi * 3.3 ), hash( n * 3.7 + fi * 9.1 ) ) * 1.1 - 0.55;
+            vec2 d = vP - c;
+            float dl = length( d ) + 1e-4;
+            float front = age * 0.5;
+            float ring = sin( ( dl - front ) * 70.0 ) * exp( -age * 3.2 ) * ( 1.0 - smoothstep( 0.0, 0.07, abs( dl - front ) ) );
+            off += d / dl * ring * 0.006;
+            lit += max( ring, 0.0 ) * 0.25;
+          }
+        }
+        vec4 rc = uReflMatrix * vec4( vW, 1.0 );
+        vec2 uv = rc.xy / rc.w + off;
+        vec3 refl = texture2D( uRefl, uv ).rgb;
+        // Standing water over black asphalt: nearly all mirror, a little darker than what it shows, the rings
+        // catching a glint of whatever lies over them.
+        vec3 col = vec3( 0.004, 0.004, 0.006 ) + refl * ( 0.82 + lit ) * uReflOn;
+        gl_FragColor = vec4( col, mask * 0.94 );
+      }`,
+  });
+  const mesh = new THREE.Mesh(geo, mat);
+  mesh.name = "front-puddle";
+  mesh.layers.set(LAYER_NO_REFLECT);
+  mesh.renderOrder = 2;
+  return {
+    mesh,
+    update(t) {
+      uTime.value = t;
+    },
+    dispose() {
+      mesh.removeFromParent();
+      geo.dispose();
+      mat.dispose();
+    },
+  };
+}
