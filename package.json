{
  "name": "cathnivore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fuzz": "tsx sim/fuzz.ts",
    "fuzz:long": "tsx sim/fuzz.ts --games 50000",
    "check": "npm run typecheck && npm run lint && npm run test && npm run fuzz -- --quick && npm run build",
    "e2e": "playwright test",
    "sim": "tsx sim/run.ts",
    "gates": "tsx scripts/gates.ts",
    "release": "tsx scripts/release.ts",
    "build:site": "tsc -b && tsx scripts/build-site.ts",
    "e2e:site": "playwright test -c playwright.site.config.ts",
    "shots": "playwright test --project=phone --project=desktop-chromium e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.4",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fast-check": "^3.23.1",
    "lighthouse": "^13.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
